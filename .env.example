# Flask session secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_random_secret_key_here

# PostgreSQL connection string (optional — omit to use local SQLite fallback)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Google OAuth — https://console.cloud.google.com/ → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# CoinGecko API key (Demo plan) — https://www.coingecko.com/en/api
# The app works without a key but may hit rate limits.
COINGECKO_API_KEY=your_coingecko_demo_api_key_here


# Private read-only export for Sage/OpenClaw — keep secret
PORTFOLIO_EXPORT_TOKEN=your_long_random_export_token_here
# Optional: lock export to a specific signed-in portfolio owner email
PORTFOLIO_EXPORT_USER_EMAIL=your_google_login_email_here

# Phase 1 research pipeline
RESEARCH_DATABASE_URL=postgresql://user:password@host/research_db
SELF_BASE_URL=https://your-render-url.onrender.com
RESEARCH_LIVE_MODE=false
# Caps Stage 1 Gemini input for long podcasts so signal extraction stays responsive.
STAGE1_TRANSCRIPT_MAX_WORDS=12000
ANTHROPIC_API_KEY=your_anthropic_key_here
GEMINI_API_KEY=your_gemini_key_here
PERPLEXITY_API_KEY=your_perplexity_key_here
# OpenAI API key - REQUIRED. Used for Stage 3 research plan (GPT-5.5).
OPENAI_API_KEY=
# Supadata.ai - YouTube transcript fallback when youtube-transcript-api fails or video has no captions
# Free tier: 100 requests/month, no credit card required. Sign up at supadata.ai
SUPADATA_API_KEY=
GEMINI_STAGE1_MODEL=gemini-3.1-pro-preview
GEMINI_STAGE4_MODEL=gemini-3.1-pro-preview
GEMINI_STAGE1_THINKING_LEVEL=low
GEMINI_STAGE4_THINKING_LEVEL=medium
CLAUDE_STAGE2_MODEL=claude-opus-4-6
CLAUDE_STAGE3_MODEL=claude-opus-4-6
CLAUDE_STAGE5_MODEL=claude-opus-4-7
OPENAI_STAGE3_PLAN_MODEL=gpt-5.5
OPENAI_STAGE3_PLAN_EFFORT=medium
PERPLEXITY_STAGE3_MODEL=sonar-pro
